# Docker deployment config (copy to .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Private GitHub Release updates (read only by the backend; token needs Contents: read on Hinln/ARTEX)
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (fill in one or both; or leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=